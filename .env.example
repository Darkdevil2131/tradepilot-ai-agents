# Required before calling protected endpoints. Generate a new random value locally.
TRADEPILOT_API_KEY=replace-with-a-long-random-secret
# Local SQLite file. On Render free instances this storage is ephemeral unless a persistent disk is separately available.
TRADEPILOT_DB_PATH=./data/tradepilot.sqlite3
# Recommended production persistence. Leave empty for local SQLite.
TRADEPILOT_DATABASE_URL=
# Optional distributed rate limiting. Without this, the limiter is per process.
REDIS_URL=
# External email is disabled unless explicitly enabled and configured.
TRADEPILOT_SMTP_ENABLED=false
TRADEPILOT_SMTP_HOST=
TRADEPILOT_SMTP_PORT=587
TRADEPILOT_SMTP_SENDER=
TRADEPILOT_SMTP_USERNAME=
TRADEPILOT_SMTP_PASSWORD=
# Optional separate credentials. The legacy API key remains an administrator key.
TRADEPILOT_VIEWER_KEY=
TRADEPILOT_ANALYST_KEY=
TRADEPILOT_OPERATOR_KEY=
TRADEPILOT_APPROVER_KEY=
TRADEPILOT_ADMIN_KEY=
# Gemini is optional. Keep false for offline operation; enable only after confirming your Google AI Studio project stays on its no-cost tier.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LOG_LEVEL=INFO
API_RATE_LIMIT_PER_MINUTE=60
GEMINI_TIMEOUT_MS=5000

# Optional, operator-approved road router and Open-Meteo-compatible forecast.
# Keep empty until endpoints are available on an eligible plan.
TRADEPILOT_OSRM_URL=
TRADEPILOT_OSRM_PROFILE=driving
TRADEPILOT_FORECAST_URL=
# Opt in only with an approved no-charge entitlement for truck routing and tolls.
TRADEPILOT_HERE_TRUCK_ENABLED=false
TRADEPILOT_HERE_API_KEY=
