# Required before calling protected endpoints. Generate a new random value locally.
TRADEPILOT_API_KEY=replace-with-a-long-random-secret
# Local SQLite file. On Render free instances this storage is ephemeral unless a persistent disk is separately available.
TRADEPILOT_DB_PATH=./data/tradepilot.sqlite3
# Gemini is optional. Keep false for offline operation; enable only after confirming your Google AI Studio project stays on its no-cost tier.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LOG_LEVEL=INFO
API_RATE_LIMIT_PER_MINUTE=60
GEMINI_TIMEOUT_MS=5000
